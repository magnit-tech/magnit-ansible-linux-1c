# transform.vrl
structured, err = parse_regex(.message, r'\{(?P<DateTime>\d{14}),(?P<TransactionStatus>\w),\s+\{(?P<TransactionDate>.+?)\},(?P<User_1>\d+),(?P<Computer_2>\d+),(?P<Application_3>\d+),(?P<Connection>\d+),(?P<Event_4>\d+),(?P<Severity>\w),"(?P<Comment>[ЁёА-я0-9 \s\S\n\w]*?)",(?P<Metadata_5>\d+),\s+(?P<Data>[ЁёА-я0-9 \s\S\n\w]*?\}),"(?P<DataPresentation>.*?)",(?P<Server_6>\d+),(?P<MainPort_7>\d+),(?P<AddPort_8>\d+),(?P<Session>\d+)', numeric_groups: false)                                          
. = merge(., structured)
.DateTime, errEventTimestamp = parse_timestamp(structured.DateTime, "%Y%m%d%H%M%S")
.err = err
